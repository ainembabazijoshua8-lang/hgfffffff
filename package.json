{
  "name": "jebri-safaris",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jebri Safaris — East African Adventure & Tours (fullstack site)",
  "scripts": {
    "dev": "concurrently -k -n FE,BE -c blue,green \"vite\" \"node server/index.js\"",
    "dev:fe": "vite",
    "dev:be": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/verify-csp-origins.mjs && node scripts/verify-contrast.mjs && vite build --config vite.smoke.config.js && node scripts/run-smoke.mjs",
    "verify": "node scripts/verify-tour-parks.mjs && node scripts/verify-csp-origins.mjs && node scripts/verify-contrast.mjs",
    "start": "node server/index.js --prod"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "maplibre-gl": "^6.13.0",
    "nodemailer": "9.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "6.30.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "vite": "8.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
